# Host ports (change if 5432/11434 are taken by another local stack)
PG_PORT=5432
OLLAMA_PORT=11434
DATABASE_URL=postgresql://kg:kg@localhost:5432/kg
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
EMBED_MODEL=embeddinggemma
USE_JEV=false
TYPESAFE_API_KEY=
SUFFICIENCY_THRESHOLD=0.6
VERIFY_THRESHOLD=0.5
# assistant (default: standard RAG, one cited answer) | classic (claims pipeline)
ANSWER_MODE=assistant
HF_HUB_OFFLINE=1
